# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Hugging Face token (required for gated models)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model cache directory (optional; defaults to ~/.cache/huggingface)
# HF_HOME=/path/to/large/disk/.cache/huggingface

# ── Model IDs (override if you use a mirror or local clone) ──
ASR_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
TRANS_INDIC_EN_MODEL_ID=ai4bharat/indictrans2-indic-en-dist-200M
TRANS_EN_INDIC_MODEL_ID=ai4bharat/indictrans2-en-indic-dist-200M
LLM_MODEL_ID=bharatgenai/Param-1-2.9B-Instruct
TTS_MODEL_ID=ai4bharat/indic-parler-tts
EMBED_MODEL_ID=BAAI/bge-m3

# ── Runtime knobs ──
# How many retrieved chunks to pass to Param1
RAG_TOP_K=5
# Minimum hybrid retrieval score to accept (0–1)
RAG_MIN_SCORE=0.25
# Keep Param1 and embedder resident in RAM/VRAM between requests
KEEP_LLM_RESIDENT=true
KEEP_EMBED_RESIDENT=true
KEEP_TTS_RESIDENT=true
# ASR decoding: ctc | rnnt
ASR_DECODE_MODE=rnnt
# Hindi answer route: direct | pivot (pivot = hi→en→en→hi)
HINDI_ROUTE=both

# ── FastAPI ──
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
